@model IEnumerable<AkarangaBankMvc.Web.Models.AuditLog>
@{
    ViewData["Title"] = "Piste d'audit";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Piste d'audit</h1>
    <span class="badge bg-secondary">Journal immuable</span>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-3">
                <input type="text" name="action" value="@ViewBag.Action"
                       class="form-control" placeholder="Action (ex: Creation_Client)..." />
            </div>
            <div class="col-md-3">
                <input type="text" name="table" value="@ViewBag.Table"
                       class="form-control" placeholder="Table (ex: Clients)..." />
            </div>
            <div class="col-md-2">
                <input type="date" name="du" value="@ViewBag.Du?.ToString("yyyy-MM-dd")"
                       class="form-control" />
            </div>
            <div class="col-md-2">
                <input type="date" name="au" value="@ViewBag.Au?.ToString("yyyy-MM-dd")"
                       class="form-control" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel"></i> Filtrer
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date (UTC)</th>
                        <th>Utilisateur</th>
                        <th>Agence</th>
                        <th>Action</th>
                        <th>Table</th>
                        <th>ID Enreg.</th>
                        <th>IP</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <em>Aucune trace d'audit trouvée pour ces critères.</em>
                            </td>
                        </tr>
                    }
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td>@log.DateEvenement.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>@(log.Utilisateur?.Email ?? log.Utilisateur?.NomComplet ?? "Système")</td>
                            <td>@(log.Agence?.Code ?? "—")</td>
                            <td>
                                <span class="badge @(log.Action.StartsWith("Creation") ? "bg-success" : log.Action.StartsWith("Modification") ? "bg-warning text-dark" : "bg-danger")">
                                    @log.Action
                                </span>
                            </td>
                            <td><code>@log.TableConcernee</code></td>
                            <td>@(log.EnregistrementId?.ToString() ?? "—")</td>
                            <td><small>@(log.AdresseIP ?? "—")</small></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@log.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> Détails
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@i"
                       asp-route-action="@ViewBag.Action"
                       asp-route-table="@ViewBag.Table"
                       asp-route-du="@ViewBag.Du?.ToString("yyyy-MM-dd")"
                       asp-route-au="@ViewBag.Au?.ToString("yyyy-MM-dd")">@i</a>
                </li>
            }
        </ul>
    </nav>
}

