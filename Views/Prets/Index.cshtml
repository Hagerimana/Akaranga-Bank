@model AkarangaBankMvc.Web.ViewModels.PretListViewModel

@{
    ViewData["Title"] = "Prêts";
}

<h1>Prêts</h1>

@if (TempData["Success"] is string msg)
{
    <div class="alert alert-success" role="alert">@msg</div>
}

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger" role="alert">@err</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="recherche" value="@Model.Recherche"
               class="form-control"
               placeholder="Référence, nom ou numéro client..." />
    </div>

    <div class="col-md-3">
        <select name="typePretId" class="form-select">
            <option value="">-- Tous les types --</option>

            @foreach (var type in Model.TypesPret)
            {
                <option value="@type.Id"
                        selected="@(type.Id == Model.TypePretId ? "selected" : null)">
                    @type.Libelle
                </option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <select name="statut" class="form-select">
            <option value="">-- Statut --</option>

            @foreach (var statut in new[]
            {
                "EnAttente", "Valide", "Rejete", "EnCours",
                "Solde", "Impaye"
            })
            {
                <option value="@statut"
                        selected="@(Model.Statut == statut ? "selected" : null)">
                    @statut
                </option>
            }
        </select>
    </div>

    <div class="col-md-3 d-flex gap-1">
        <button type="submit" class="btn btn-primary w-100">Filtrer</button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Réinitialiser
        </a>
    </div>
</form>

<div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span class="text-muted">@Model.Total prêt(s) trouvé(s).</span>

    <div class="d-flex gap-2">
        @if (User.IsInRole("admin"))
        {
            <form asp-action="MettreAJourRetards" method="post">
                <button type="submit" class="btn btn-outline-warning">
                    Mettre à jour les retards
                </button>
            </form>
        }

        @if (User.IsInRole("admin") || User.IsInRole("gestionnaire") ||
             User.IsInRole("guichetier"))
        {
            <a asp-action="Create" class="btn btn-primary">
                + Nouvelle demande
            </a>
        }
    </div>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th scope="col">Référence</th>
            <th scope="col">Client</th>
            <th scope="col">Type</th>
            <th scope="col" class="text-end">Montant</th>
            <th scope="col" class="text-end">Durée</th>
            <th scope="col" class="text-end">Taux</th>
            <th scope="col" class="text-end">Mensualité</th>
            <th scope="col">Statut</th>
            <th scope="col">Demande</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (!Model.Prets.Any())
        {
            <tr>
                <td colspan="10" class="text-center text-muted">
                    Aucun prêt ne correspond aux critères.
                </td>
            </tr>
        }

        @foreach (var pret in Model.Prets)
        {
            <tr>
                <td>@pret.Reference</td>
                <td>
                    @pret.Client.Nom @pret.Client.Prenom
                    <br />
                    <small class="text-muted">@pret.Client.NumeroClient</small>
                </td>
                <td>@pret.TypePret.Libelle</td>
                <td class="text-end">
                    @pret.MontantPrincipal.ToString("N2") BIF
                </td>
                <td class="text-end">@pret.DureeMois mois</td>
                <td class="text-end">@pret.TauxInteret.ToString("N2") %</td>
                <td class="text-end">
                    @pret.Mensualite.ToString("N2") BIF
                </td>
                <td>
                    @{
                        var couleur = pret.Statut switch
                        {
                            "EnAttente" => "bg-warning text-dark",
                            "Valide" => "bg-info text-dark",
                            "EnCours" => "bg-primary",
                            "Solde" => "bg-success",
                            "Rejete" => "bg-danger",
                            "Impaye" => "bg-dark",
                            _ => "bg-secondary"
                        };
                    }

                    <span class="badge @couleur">@pret.Statut</span>
                </td>
                <td>@pret.DateDemande.ToString("dd/MM/yyyy")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@pret.Id"
                       class="btn btn-sm btn-primary">
                        Détails
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Pagination des prêts">
        <ul class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i"
                       asp-route-recherche="@Model.Recherche"
                       asp-route-statut="@Model.Statut"
                       asp-route-typePretId="@Model.TypePretId">
                        @i
                    </a>
                </li>
            }
        </ul>
    </nav>
}
