@model AkarangaBankMvc.Web.ViewModels.ReleveViewModel

@{
    ViewData["Title"] = "Relevé";
}

<h1>Relevé de compte</h1>

<div class="card mb-3">
    <div class="card-body">
        <h5>@Model.Compte.NumeroCompte</h5>

        <p>
            <strong>Solde initial :</strong>
            @Model.SoldeInitial.ToString("N2") @Model.Compte.Devise
            <br />

            <strong>Solde final :</strong>
            @Model.SoldeFinal.ToString("N2") @Model.Compte.Devise
        </p>
    </div>
</div>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Date</th>
            <th>Libellé</th>
            <th class="text-end">Débit</th>
            <th class="text-end">Crédit</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var e in Model.Ecritures)
        {
            <tr>
                <td>
                    @e.DateEcriture.ToString("dd/MM/yyyy HH:mm")
                </td>

                <td>@e.Libelle</td>

                <td class="text-end text-danger">
                    @(e.Sens == "Debit"
                        ? e.Montant.ToString("N2")
                        : "")
                </td>

                <td class="text-end text-success">
                    @(e.Sens == "Credit"
                        ? e.Montant.ToString("N2")
                        : "")
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Journal" class="btn btn-secondary">
    Retour
</a>