@model IEnumerable<AkarangaBankMvc.Web.Models.VirementInterAgence>

@{
    ViewData["Title"] = SharedLocalizer["Nav_Virements"].Value;
    var lignes = Model.ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 fw-bold">@SharedLocalizer["Nav_Virements"]</h1>
        <p class="text-muted mb-0">@SharedLocalizer["Common_Pending"]</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Initier" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="bi bi-send-plus"></i>
            <span>@SharedLocalizer["Common_Create"]</span>
        </a>
        <a asp-action="Historique" class="btn btn-outline-secondary d-flex align-items-center gap-2">
            <i class="bi bi-clock-history"></i>
            <span>@SharedLocalizer["Common_Details"]</span>
        </a>
    </div>
</div>

@if (TempData["Success"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@SharedLocalizer["Common_Close"]"></button>
    </div>
}

@if (TempData["Error"] is string erreur)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @erreur
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@SharedLocalizer["Common_Close"]"></button>
    </div>
}

<div class="card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">@SharedLocalizer["Common_Date"]</th>
                    <th scope="col">@SharedLocalizer["Common_Code"]</th>
                    <th scope="col">Source</th>
                    <th scope="col">Destination</th>
                    <th scope="col" class="text-end">@SharedLocalizer["Common_Amount"]</th>
                    <th scope="col">@SharedLocalizer["Common_Actions"]</th>
                </tr>
            </thead>

            <tbody>
                @if (!lignes.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            @SharedLocalizer["Common_Error"]
                        </td>
                    </tr>
                }

                @foreach (var v in lignes)
                {
                    <tr>
                        <td>@v.DateCreation.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><code>@v.Reference</code></td>

                        <td>
                            <span class="badge bg-secondary">@v.AgenceSource.Code</span><br />
                            <small class="text-muted">@v.Virement.CompteSource.NumeroCompte</small>
                        </td>

                        <td>
                            <span class="badge bg-secondary">@v.AgenceDestination.Code</span><br />
                            <small class="text-muted">@v.Virement.CompteDestination.NumeroCompte</small>
                        </td>

                        <td class="text-end fw-bold">
                            @v.Montant.ToString("N2") @v.Devise
                        </td>

                        <td>
                            @if (User.IsInRole("admin"))
                            {
                                <form asp-action="Valider" method="post" class="mb-2">
                                    <input type="hidden" name="id" value="@v.Id" />

                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i class="bi bi-check-lg me-1"></i> @SharedLocalizer["Common_Validate"]
                                    </button>
                                </form>

                                <form asp-action="Rejeter" method="post">
                                    <input type="hidden" name="id" value="@v.Id" />

                                    <div class="input-group input-group-sm">
                                        <input id="motif-@v.Id" name="motif" maxlength="500" required
                                               class="form-control" placeholder="@SharedLocalizer["Common_Reject"]..." />
                                        <button type="submit" class="btn btn-outline-danger">
                                            @SharedLocalizer["Common_Reject"]
                                        </button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">
                                    Admin Only
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>