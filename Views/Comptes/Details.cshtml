@model AkarangaBankMvc.Web.ViewModels.CompteDetailsViewModel

@{
    ViewData["Title"] = "Détails du compte";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-0">Compte @Model.Compte.NumeroCompte</h1>
        <p class="text-muted mb-0">Agence @Model.Compte.Agence.Code - @Model.Compte.Agence.Ville</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="DocumentsPdf" asp-action="Releve" asp-route-compteId="@Model.Compte.Id" class="btn btn-outline-primary">
            <i class="bi bi-file-earmark-pdf me-1"></i> Relevé PDF
        </a>
        <a asp-controller="DocumentsPdf" asp-action="AttestationSolde" asp-route-compteId="@Model.Compte.Id" class="btn btn-outline-secondary">
            <i class="bi bi-patch-check me-1"></i> Attestation de solde (PDF)
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            Retour
        </a>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Client</dt>
    <dd class="col-sm-9">
        @if (Model.Compte.Client is not null && Model.Compte.ClientId.HasValue)
        {
            <a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.Compte.ClientId.Value">
                @Model.Compte.Client.Nom @Model.Compte.Client.Prenom
            </a>
        }
        else
        {
            <span class="text-muted">Compte interne</span>
        }
    </dd>

    <dt class="col-sm-3">Type</dt>
    <dd class="col-sm-9">@Model.Compte.TypeCompte.Libelle</dd>

    <dt class="col-sm-3">Agence</dt>
    <dd class="col-sm-9">
        @Model.Compte.Agence.Code - @Model.Compte.Agence.Ville
    </dd>

    <dt class="col-sm-3">Solde</dt>
    <dd class="col-sm-9">
        <strong class="fs-5 text-primary">
            @Model.Compte.Solde.ToString("N2") @Model.Compte.Devise
        </strong>
    </dd>

    <dt class="col-sm-3">Statut</dt>
    <dd class="col-sm-9">
        <span class="badge @(Model.Compte.Statut == "Actif" ? "bg-success" : "bg-warning text-dark")">@Model.Compte.Statut</span>
    </dd>

    <dt class="col-sm-3">Date d'ouverture</dt>
    <dd class="col-sm-9">
        @Model.Compte.DateOuverture.ToString("dd/MM/yyyy")
    </dd>
</dl>

<h2 class="h5 mt-4 mb-3">Dernières écritures comptables</h2>

@if (!Model.Ecritures.Any())
{
    <p class="text-muted">Aucune écriture enregistrée.</p>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0" role="table" aria-label="Écritures comptables du compte">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Opération</th>
                        <th scope="col">Sens</th>
                        <th scope="col" class="text-end">Montant</th>
                        <th scope="col">Libellé</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var e in Model.Ecritures)
                    {
                        <tr>
                            <td class="small">@e.DateEcriture.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><code>@e.Operation.Reference</code></td>
                            <td>
                                <span class="badge @(e.Sens == "Debit" ? "bg-danger" : "bg-success")">@e.Sens</span>
                            </td>
                            <td class="text-end fw-semibold">
                                @e.Montant.ToString("N2") @e.Devise
                            </td>
                            <td>@e.Libelle</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
