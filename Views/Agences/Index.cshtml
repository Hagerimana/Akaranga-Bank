@model AkarangaBankMvc.Web.ViewModels.AgenceListViewModel
@{
    ViewData["Title"] = SharedLocalizer["Nav_Agences"].Value;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 fw-bold">@SharedLocalizer["Nav_Agences"]</h1>
        <p class="text-muted mb-0">@SharedLocalizer["Home_AgencesDesc"]</p>
    </div>
    <a asp-action="Create" class="btn btn-success d-flex align-items-center gap-2">
        <i class="bi bi-plus-circle"></i>
        <span>@SharedLocalizer["Common_Create"]</span>
    </a>
</div>

@* Messages flash *@
@if (TempData["Success"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@SharedLocalizer["Common_Close"]"></button>
    </div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @err
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@SharedLocalizer["Common_Close"]"></button>
    </div>
}

@* Barre de recherche *@
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="recherche" value="@Model.Recherche" class="form-control border-start-0"
                           placeholder="@SharedLocalizer["Common_Search"] (@SharedLocalizer["Common_Code"], @SharedLocalizer["Common_Name"], @SharedLocalizer["Common_City"])..." />
                </div>
            </div>
            <div class="col-md-3 text-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i> @SharedLocalizer["Common_Search"]
                </button>
            </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2 text-muted small">
    <span>@SharedLocalizer["Common_Total"] : <strong>@Model.Total</strong></span>
</div>

@* Tableau *@
<div class="card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@SharedLocalizer["Common_Code"]</th>
                    <th>@SharedLocalizer["Common_Name"]</th>
                    <th>@SharedLocalizer["Common_City"]</th>
                    <th>@SharedLocalizer["Common_Status"]</th>
                    <th class="text-end">@SharedLocalizer["Common_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var agence in Model.Agences)
                {
                    <tr>
                        <td class="fw-semibold"><code>@agence.Code</code></td>
                        <td>@agence.Nom</td>
                        <td><i class="bi bi-geo-alt me-1 text-muted"></i>@agence.Ville</td>
                        <td>
                            @if (agence.EstSiege)
                            {
                                <span class="badge bg-primary">Siège</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Agence</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@agence.Id" class="btn btn-outline-primary" title="@SharedLocalizer["Common_Details"]">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@agence.Id" class="btn btn-outline-warning" title="@SharedLocalizer["Common_Edit"]">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@agence.Id" class="btn btn-outline-danger" title="@SharedLocalizer["Common_Delete"]">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Pagination *@
@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-recherche="@Model.Recherche">@i</a>
                </li>
            }
        </ul>
    </nav>
}