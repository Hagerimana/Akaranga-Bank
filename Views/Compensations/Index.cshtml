@model IEnumerable<AkarangaBankMvc.Web.Models.CompensationAgence>

@{
    ViewData["Title"] = "Compensations inter-agences";

    DateTime jour = ViewBag.Date;
    string devise = ViewBag.Devise;
    var lignes = Model.ToList();
}

<h1>Compensations inter-agences</h1>

<p class="text-muted">
    Calcul des positions journalières à partir des écritures
    de virements inter-agences. Les journées sont en UTC.
</p>

@if (TempData["Success"] is string message)
{
    <div class="alert alert-success">@message</div>
}

@if (TempData["Error"] is string erreur)
{
    <div class="alert alert-danger">@erreur</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5">Calculer une compensation</h2>

        <form asp-action="Calculer" method="post" class="row g-3">
            <div class="col-md-4">
                <label for="calculAgence" class="form-label">
                    Agence
                </label>

                <select id="calculAgence" name="agenceId" asp-items="ViewBag.Agences" class="form-select" required>
                    <option value="">Sélectionner une agence</option>
                </select>
            </div>

            <div class="col-md-3">
                <label for="calculDate" class="form-label">
                    Journée UTC
                </label>

                <input id="calculDate" type="date" name="date" value="@jour.ToString("yyyy-MM-dd")" class="form-control"
                       required />
            </div>

            <div class="col-md-2">
                <label for="calculDevise" class="form-label">
                    Devise
                </label>

                <input id="calculDevise" name="devise" value="@devise" maxlength="3" pattern="[A-Za-z]{3}"
                       class="form-control" required />
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary">
                    Calculer / Recalculer
                </button>
            </div>
        </form>
    </div>
</div>

<h2 class="h5">Consulter les compensations calculées</h2>

<form asp-action="Index" method="get" class="row g-3 mb-3">
    <div class="col-md-4">
        <label for="filtreAgence" class="form-label">Agence</label>

        <select id="filtreAgence" name="agenceId" asp-items="ViewBag.Agences" class="form-select">
            <option value="">Toutes les agences</option>
        </select>
    </div>

    <div class="col-md-3">
        <label for="filtreDate" class="form-label">Journée UTC</label>

        <input id="filtreDate" type="date" name="date" value="@jour.ToString("yyyy-MM-dd")" class="form-control"
               required />
    </div>

    <div class="col-md-2">
        <label for="filtreDevise" class="form-label">Devise</label>

        <input id="filtreDevise" name="devise" value="@devise" maxlength="3" pattern="[A-Za-z]{3}" class="form-control"
               required />
    </div>

    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-outline-primary">
            Filtrer
        </button>
    </div>
</form>

<div class="mb-3">
    <a asp-action="Verifier" asp-route-date="@jour.ToString("yyyy-MM-dd")" asp-route-devise="@devise"
       class="btn btn-outline-success">
        Vérifier l'équilibre de toutes les agences
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-sm align-middle">
        <thead>
            <tr>
                <th>Date</th>
                <th>Agence</th>
                <th>Compte</th>
                <th class="text-end">Total débits</th>
                <th class="text-end">Total crédits</th>
                <th class="text-end">Solde</th>
                <th>Devise</th>
                <th>Statut</th>
            </tr>
        </thead>

        <tbody>
            @if (!lignes.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-3">
                        Aucune compensation calculée pour ces critères.
                        Utilise le formulaire ci-dessus.
                    </td>
                </tr>
            }

            @foreach (var c in lignes)
            {
                <tr>
                    <td>@c.DateCompensation.ToString("dd/MM/yyyy")</td>
                    <td>@c.Agence.Code</td>
                    <td>@c.CompteCompensation.NumeroCompte</td>
                    <td class="text-end">@c.TotalDebits.ToString("N2")</td>
                    <td class="text-end">@c.TotalCredits.ToString("N2")</td>
                    <td class="text-end">@c.Solde.ToString("N2")</td>
                    <td>@c.Devise</td>
                    <td>
                        <span class="badge @(c.Statut == "Regle"
                              ? "bg-success"
                              : c.Statut == "Equilibre"
                                ? "bg-info text-dark"
                                : "bg-warning text-dark")">
                            @c.Statut
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>



<div class="card my-3">
    <div class="card-body">
        <h2 class="h5">Régler deux positions opposées</h2>

        <p class="text-muted">
            Règlement comptable interne uniquement.
            La journée UTC doit être terminée.
            Les deux positions doivent avoir le même montant.
        </p>

        <form asp-action="Regler" method="post" class="row g-3">
            <input type="hidden" name="date" value="@jour.ToString("yyyy-MM-dd")" />

            <input type="hidden" name="devise" value="@devise" />

            <div class="col-md-5">
                <label class="form-label">Position positive</label>

                <select name="compensationPositiveId" class="form-select" required>
                    <option value="">Sélectionner</option>

                    @foreach (var c in lignes.Where(c =>
                        c.Solde > 0m && c.Statut == "EnCours"))
                    {
                        <option value="@c.Id">
                            @c.Agence.Code —
                            @c.CompteCompensation.NumeroCompte —
                            @c.Solde.ToString("N2") @c.Devise
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-5">
                <label class="form-label">Position négative</label>

                <select name="compensationNegativeId" class="form-select" required>
                    <option value="">Sélectionner</option>

                    @foreach (var c in lignes.Where(c =>
                        c.Solde < 0m && c.Statut == "EnCours"))
                    {
                        <option value="@c.Id">
                            @c.Agence.Code —
                            @c.CompteCompensation.NumeroCompte —
                            @c.Solde.ToString("N2") @c.Devise
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-success">
                    Régler les deux
                </button>
            </div>
        </form>
    </div>
</div>

<p class="text-muted">
    Solde = total crédits - total débits du compte de compensation.
    Le calcul ne modifie pas les soldes des comptes.
    Les fiches restent provisoires tant que la journée
    peut recevoir de nouveaux virements.
</p>

<a asp-controller="Operations" asp-action="Journal" class="btn btn-secondary">
    Retour au journal
</a>