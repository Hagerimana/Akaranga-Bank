@using Microsoft.AspNetCore.Identity
@using AkarangaBankMvc.Web.Models
@using Microsoft.Extensions.Localization
@using AkarangaBankMvc.Web.Resources
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> Localizer

<ul class="navbar-nav ak-user-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        <li class="nav-item">
            <span class="nav-link ak-user-name">
                <span class="ak-user-name-text" title="@currentUser?.NomComplet">@currentUser?.NomComplet</span>
                @if (currentUser?.TwoFactorEnabled == true)
                {
                    <span class="badge bg-success" title="Authentification à deux facteurs activée">2FA</span>
                }
            </span>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">@Localizer["User_MyAccount"]</a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" method="post">
                <button type="submit" class="nav-link btn btn-link">@Localizer["User_Logout"]</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">@Localizer["User_Login"]</a>
        </li>
    }
</ul>
