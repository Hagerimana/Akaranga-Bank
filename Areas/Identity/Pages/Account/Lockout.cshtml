@page
@model LockoutModel
@{
    ViewData["Title"] = "Compte verrouillé";
}

<header>
    <h1 class="text-danger">@ViewData["Title"]</h1>
    <p class="text-danger">
        Ce compte a été verrouillé suite à plusieurs tentatives de connexion échouées.
        Veuillez réessayer dans quelques minutes ou contacter votre administrateur.
    </p>
</header>
