@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Changer le mot de passe";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3>@ViewData["Title"]</h3>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="alert alert-info">
    <i class="bi bi-shield-check"></i>
    Pour des raisons de sécurité, le changement de mot de passe est confirmé par un
    <strong>code à 6 chiffres</strong> envoyé à <strong>@Model.EmailMasque</strong>.
    Le code est valable 10 minutes.
</div>

<form method="post" asp-page-handler="EnvoyerCode" class="mb-4">
    <button type="submit" class="btn btn-outline-primary">
        <i class="bi bi-envelope"></i> Recevoir un code de vérification
    </button>
</form>

<hr />

<form method="post" asp-page-handler="Changer">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <div class="form-floating mb-3">
        <input asp-for="Input.Code" class="form-control" inputmode="numeric" pattern="[0-9]{6}"
               maxlength="6" autocomplete="one-time-code" placeholder="123456" />
        <label asp-for="Input.Code">Code de vérification (6 chiffres)</label>
        <span asp-validation-for="Input.Code" class="text-danger"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Input.NouveauMotDePasse" type="password" class="form-control"
               autocomplete="new-password" placeholder="Nouveau mot de passe" />
        <label asp-for="Input.NouveauMotDePasse">Nouveau mot de passe</label>
        <span asp-validation-for="Input.NouveauMotDePasse" class="text-danger"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Input.ConfirmationMotDePasse" type="password" class="form-control"
               autocomplete="new-password" placeholder="Confirmer le mot de passe" />
        <label asp-for="Input.ConfirmationMotDePasse">Confirmer le nouveau mot de passe</label>
        <span asp-validation-for="Input.ConfirmationMotDePasse" class="text-danger"></span>
    </div>

    <p class="text-muted small">
        Minimum 12 caractères, avec au moins une majuscule, une minuscule,
        un chiffre et un caractère spécial.
    </p>

    <button type="submit" class="btn btn-primary">Changer le mot de passe</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
