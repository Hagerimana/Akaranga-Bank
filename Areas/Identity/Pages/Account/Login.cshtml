@page
@model LoginModel

@{
    Layout = null;
    ViewData["Title"] = SharedLocalizer["User_Login"].Value;
}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" data-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />

    <title>@SharedLocalizer["User_Login"] — @SharedLocalizer["AppTitle"]</title>

    <script>
        (() => {
            let theme = window.matchMedia("(prefers-color-scheme: dark)")
                .matches ? "dark" : "light";

            try {
                const saved = localStorage.getItem("ak-theme");

                if (saved === "dark" || saved === "light") {
                    theme = saved;
                }
            } catch {
                // Le thème reste utilisable sans stockage local.
            }

            document.documentElement.dataset.theme = theme;
        })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>

<body>
    <div class="login-page">
        <header class="login-topbar d-flex justify-content-between align-items-center">
            <div class="login-brand">
                <span class="login-logo" aria-hidden="true">AB</span>

                <span>
                    <span class="login-brand-name">@SharedLocalizer["AppTitle"]</span>
                    <span class="login-brand-caption">
                        @SharedLocalizer["Auth_PortalCaption"]
                    </span>
                </span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <partial name="_LanguageSelector" />

                <button id="login-theme-toggle" type="button" class="login-theme-button" aria-label="@SharedLocalizer["A11y_ToggleTheme"]">
                    @SharedLocalizer["A11y_ToggleTheme"]
                </button>
            </div>
        </header>

        <main class="login-main">
            <section class="login-card" aria-labelledby="login-title">
                <div class="login-card-heading">
                    <span class="login-card-label">
                        @SharedLocalizer["Auth_LoginSpace"]
                    </span>

                    <h1 id="login-title">@SharedLocalizer["Auth_Welcome"]</h1>

                    <p>
                        @SharedLocalizer["Auth_LoginSubtitle"]
                    </p>
                </div>

                <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl">

                    <div asp-validation-summary="ModelOnly" class="text-danger login-validation" role="alert">
                    </div>

                    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                    {
                        <div class="alert alert-success login-validation" role="status">
                            @Model.SuccessMessage
                        </div>
                    }

                    <div class="mb-4">
                        <label asp-for="Input.Email" class="form-label login-label">
                            @SharedLocalizer["Auth_Email"]
                        </label>

                        <input asp-for="Input.Email" type="email" class="form-control login-input"
                               autocomplete="username" placeholder="nom@akaranga.bi" aria-required="true" required />

                        <span asp-validation-for="Input.Email" class="text-danger small">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label login-label">
                            @SharedLocalizer["Auth_Password"]
                        </label>

                        <div class="login-password-wrapper">
                            <input asp-for="Input.Password" type="password"
                                   class="form-control login-input login-password-input" autocomplete="current-password"
                                   placeholder="@SharedLocalizer["Auth_Password"]" aria-required="true" required />

                            <button id="login-password-toggle" type="button" class="login-password-toggle"
                                    aria-controls="Input_Password" aria-label="@SharedLocalizer["Auth_Show"]"
                                    aria-pressed="false">
                                @SharedLocalizer["Auth_Show"]
                            </button>
                        </div>

                        <span asp-validation-for="Input.Password" class="text-danger small">
                        </span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="Input.RememberMe" class="form-check-input" />

                        <label asp-for="Input.RememberMe" class="form-check-label login-remember">
                            @SharedLocalizer["Auth_RememberMe"]
                        </label>
                    </div>

                    <button id="login-submit" type="submit" class="login-submit">
                        @SharedLocalizer["Auth_SignIn"]
                        <span aria-hidden="true">→</span>
                    </button>

                    <p class="login-help">
                        <a asp-page="./MotDePasseOublie">@SharedLocalizer["Auth_ForgotPassword"]</a>
                        <br />
                        @SharedLocalizer["Auth_ContactAdmin"]
                    </p>
                </form>

                <div class="login-card-footer">
                    @SharedLocalizer["Auth_NeverSharePassword"]
                </div>
            </section>
        </main>

        <footer class="login-footer">
            © @DateTime.UtcNow.Year @SharedLocalizer["AppTitle"]
            <span aria-hidden="true">·</span>
            @SharedLocalizer["Auth_ReservedSpace"]
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/login.js" asp-append-version="true"></script>
</body>

</html>
